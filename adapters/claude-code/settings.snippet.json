{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/session-start.mjs"]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/subagent-start.mjs"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/busy.mjs"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/busy.mjs"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/idle.mjs"]
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/idle.mjs"]
          }
        ]
      }
    ]
  }
}
