{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/session-start.mjs"]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/subagent-start.mjs"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/busy.mjs"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/busy.mjs"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/idle.mjs"]
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["__AGENTCHAT_ADAPTER_DIR__/idle.mjs"]
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "agentchat": {
      "type": "http",
      "url": "http://127.0.0.1:4646/mcp",
      "headers": {
        "Authorization": "Bearer ${HUB_TOKEN}",
        "x-agent-id": "${AGENTCHAT_AGENT_ID}"
      }
    }
  }
}
